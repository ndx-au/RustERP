# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Nucleus: keep .nucleus/ tracked (specs, out, attestations, state).
# Never commit the local HMAC key used to sign attestation artifacts.
.nucleus/attest.key

# Editor / OS noise
.idea/
.vscode/
*.swp
*.swo
.DS_Store
# Runtime pid/log — never commit
.local/
# Agent turn dumps often contain ops; keep specs/attestations if you want
.nucleus/out/
# Local deploy config (use rusterp-server.toml.example)
rusterp-server.toml
