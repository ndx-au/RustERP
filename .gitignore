# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Nucleus honesty-loop state — local only (never commit)
.nucleus/
# Agent turn dumps outside Nucleus
.out/

# Editor / OS noise
.idea/
.vscode/
*.swp
*.swo
.DS_Store
# Runtime pid/log — never commit
.local/
# Local deploy config (use rusterp-server.toml.example)
rusterp-server.toml
